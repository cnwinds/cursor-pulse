# 钉钉企业内部应用（复制为 .env 并填写，勿提交 Git）
DINGTALK_APP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 机器人 ID（开放平台 → 机器人 → 机器人 ID，通常以 ding 开头）
DINGTALK_ROBOT_CODE=
# 钉钉群号（chatId，示例：000000000000）；API 群发需 openConversationId
DINGTALK_CHAT_ID=
# openConversationId（cid...==）；可留空，首次 @机器人 后自动写入 team_settings.dingtalk（pulse.db）
DINGTALK_GROUP_ID=
# 管理员渠道 userid，逗号分隔（留空表示无管理员）
ADMIN_CHANNEL_USER_IDS=
# 已废弃：请改用 ADMIN_CHANNEL_USER_IDS（未配置 ADMIN_CHANNEL_USER_IDS 时回落到此项）
DINGTALK_ADMIN_USER_IDS=

# LLM（报告洞察层，可选）
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
VISION_ENABLED=false
VISION_MODEL=

# Web 管理后台
ADMIN_WEB_TOKEN=
# Plaintext or pbkdf2 hash (salt$hex); generate: python -c "from pulse.web.passwords import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD=
JWT_SECRET=
DINGTALK_OAUTH_REDIRECT_URI=http://localhost:5173/login/callback
WEB_CORS_ORIGINS=http://localhost:5173

# 多团队（同一数据库多团队隔离；单团队可保持 default）
PULSE_TEAM_SLUG=default

# FinOps / BI Webhook
BI_WEBHOOK_URL=
BI_WEBHOOK_SECRET=

# Postgres（docker-compose.postgres.yml）
DATABASE_URL=

# S3 / MinIO 对象存储
S3_ENABLED=false
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Cursor Teams Admin API（可选，与 CSV 并存）
CURSOR_TEAMS_API_KEY=

# 32-byte base64 or hex key for encrypting Cursor API Keys
PULSE_CREDENTIAL_ENCRYPTION_KEY=

# 群平台（默认 dingtalk）
# none = Web-only（默认推荐开源形态）；dingtalk | feishu 启用对应机器人入站
BOT_PLATFORM=none

# 飞书自建应用（BOT_PLATFORM=feishu 时必填；开放平台 → 凭证与基础信息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 机器人自身 open_id（可选，用于过滤自发消息）
FEISHU_BOT_OPEN_ID=
# 默认群 chat_id（send_group_text 目标；可选，也可按会话回复而无需预先配置）
FEISHU_GROUP_CHAT_ID=

# 用量提交催办（收集开始群通知 / 每日私聊催交 / 截止日 @全员）；默认关闭
# USAGE_REMINDERS_ENABLED=true

# --- B: control-plane URLs (never via HTTP_PROXY; see docs/PROXY_LAYERS.md) ---
# Pulse 控制面 base URL（Assistant / Go Proxy 访问 Pulse；Docker 内常用 http://web:8080）
PULSE_BASE_URL=http://127.0.0.1:8080

# Pulse internal API token（Pulse 进程读取 PULSE_INTERNAL_SERVICE_TOKEN）
# Assistant→Pulse 使用 PULSE_INTERNAL_TOKEN（通常与 SERVICE_TOKEN 同值，变量名不同）
PULSE_INTERNAL_SERVICE_TOKEN=
PULSE_INTERNAL_TOKEN=

# --- A: Cursor MITM (user sets HTTPS_PROXY to this URL) ---
# Cursor 代理客户端可达地址（写入一键复制命令的 HTTPS_PROXY）
PROXY_PUBLIC_URL=http://127.0.0.1:8317

# --- C: egress / Go upstream (NOT the same as user HTTPS_PROXY) ---
# Go 代理访问 Cursor 上游时使用的出站代理（翻墙）；空=直连。
# 支持无认证与 Basic 认证：
# PROXY_UPSTREAM_URL=http://127.0.0.1:7890
# PROXY_UPSTREAM_URL=http://user:pass@127.0.0.1:7890
# 宿主机 Python 出站（Cursor sync / 钉钉 OAuth）可另设系统 HTTP_PROXY / HTTPS_PROXY。

# 用量/模型旁路诊断：开启后打全量候选字符串，并落盘请求体到 ~/.cursor-quota-proxy/debug-usage/
# PROXY_DEBUG_USAGE=1
# PROXY_DEBUG_USAGE_DIR=/path/to/.dev/proxy-debug-usage

# 联网搜索（Tavily；仅 Pulse 配置层读取，勿写入 Assistant 日志/会话）
# TAVILY_API_KEY=
# TAVILY_SEARCH_URL=https://api.tavily.com/search
# WEB_SEARCH_ENABLED=false
# WEB_SEARCH_TIMEOUT_SECONDS=10
# WEB_SEARCH_MAX_RESULTS=5

# --- B: Assistant mirror (Pulse → Assistant; internal_client, never via HTTP_PROXY) ---
# Assistant Platform 旁路（Phase 0；默认关闭）
ASSISTANT_MIRROR_ENABLED=false
ASSISTANT_MIRROR_BASE_URL=http://127.0.0.1:8090
ASSISTANT_SERVICE_TOKEN=
ASSISTANT_DATABASE_URL=sqlite:///data/assistant.db
ASSISTANT_PORT=8090
# Secret Store（生产必须独立高熵密钥，勿复用 service token）
ASSISTANT_SECRET_KEY=

# Assistant Platform 能力桥（Phase 1；默认关闭，失败回退 legacy）
# CAPABILITY_BRIDGE_QUOTA_SELF_READ=false
# CAPABILITY_BRIDGE_CURSOR_KEY_BIND=false
# CAPABILITY_BRIDGE_GUIDE_IMAGE_UPDATE=false

# Assistant Platform LLM（可选）
ASSISTANT_LLM_ENABLED=false
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1
ASSISTANT_LLM_MODEL=
# 交互会话并发（session.process / reply.send）；后台关闭总结单独用 BG worker，互不阻塞
ASSISTANT_JOB_WORKER_COUNT=4
ASSISTANT_JOB_BG_WORKER_COUNT=1
